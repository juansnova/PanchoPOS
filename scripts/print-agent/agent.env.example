# Copy to agent.env (ignored by git) and fill in. One KEY=VALUE per line.
# Token: Administración → Impresión → Crear agente (shown once).
PRINT_AGENT_API_BASE=http://127.0.0.1:4202/api
PRINT_AGENT_TOKEN=
# Printer targets in priority order: tcp:IP (Ethernet/WiFi), win:NAME (USB), file:PATH
KITCHEN_PRINTER=win:DigitalPOS
RECEIPT_PRINTER=win:DigitalPOS
PRINT_AGENT_POLL_SEC=1
